# Google OAuth 設定
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_CALLBACK_URL=https://your-backend.zeabur.app/auth/callback

# JWT 安全設定
JWT_SECRET=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 資料庫設定 (Zeabur 會自動注入 PostgreSQL 的 DATABASE_URL)
DATABASE_URL=postgresql://username:password@host:port/database

# 前端 URL (單服務模式下可留空或填寫部署域名)
FRONTEND_URL=https://your-app.zeabur.app

# Email Settings (Gmail App Password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_name
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
ADMIN_EMAILS=admin@example.com
